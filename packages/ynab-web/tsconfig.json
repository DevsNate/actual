{
  "extends": "@ember/app-tsconfig",
  "include": ["app", "tests", "types"],
  "compilerOptions": {
    "allowJs": true,
    "paths": {
      "@actual-app/ynab-web/tests/*": ["./tests/*"],
      "@actual-app/ynab-web/*": ["./app/*"],
      "*": ["./types/*"]
    },
    "types": [
      "ember-source/types",
      "@embroider/core/virtual",
      "vite/client",
      "@glint/ember-tsc/types"
    ]
  },
  "references": [
    {
      "path": "../semantic-core"
    }
  ]
}
